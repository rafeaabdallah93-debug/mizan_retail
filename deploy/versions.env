# Where deploy/build.sh gets each app, and at which exact commit.
# Each *_SRC is a git URL or a local folder (a git checkout); each *_REF is a commit
# SHA (or any git ref; it is resolved to a SHA and recorded on the image).
# Override any of these for one build on the command line, for example:
#   MIZAN_CORE_SRC=../mizan_core MIZAN_CORE_REF=HEAD deploy/build.sh shop
#
# Last verified together (Task 9b): see deploy/README.md, "Pinned versions".

MIZAN_CORE_SRC=https://github.com/rafeaabdallah93-debug/mizan_core.git
MIZAN_CORE_REF=eedfcf02c25d1f71fc1f883d8ab4fb20c2578dd6

# mizan_retail is this repository: by default the image contains the commit you
# have checked out (HEAD of this checkout), so check out a release commit first.
MIZAN_RETAIL_SRC=.
MIZAN_RETAIL_REF=HEAD

# The WooCommerce connector (shop-web edition only), installed unchanged.
WOOCOMMERCE_FUSION_SRC=https://github.com/Starktail/woocommerce_fusion.git
WOOCOMMERCE_FUSION_REF=ab71a15d322232fff58d93fa0aa469812bfa9a30
