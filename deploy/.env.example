# Mizan shop settings. Copy this file to deploy/.env and fill it in:
#   cp deploy/.env.example deploy/.env
# Keep deploy/.env private: it holds your passwords. Never share or commit it.

# The image to run. deploy/build.sh fills this in for you, e.g.
#   deploy/build.sh shop deploy/.env
MIZAN_IMAGE=

# Your shop's address (site name). For use on this computer only, keep the
# default. For a server with a domain, use the domain, e.g. erp.myshop.com
SITE_NAME=mizan.localhost

# Your company, exactly as it should appear on invoices, and a short
# abbreviation (letters only, e.g. MS). These are used ONCE, when the shop is
# first created. Changing them later has no effect.
COMPANY=My Shop
ABBR=MS

# Language of the screens: ar (Arabic) or en (English)
LANGUAGE=ar

# Password of the "Administrator" login: at least 12 characters, required.
# Used once, when the shop is first created; change it later inside Mizan.
ADMIN_PASSWORD=

# Password of the database's "root" account: at least 12 characters, required.
# Write it down. Used when the database is first created; it cannot be changed here later.
DB_ROOT_PASSWORD=

# The port to open in the browser: http://localhost:<HTTP_PORT>
# Defaults: shop edition 8081, shop-web edition 8082.
#HTTP_PORT=8081

# Who may open Mizan. 127.0.0.1 (default) = only this computer.
# 0.0.0.0 = also other computers and tills on the shop's network, over plain,
# UNENCRYPTED http. Read "Other computers in the shop" in deploy/README.md first.
#HTTP_BIND=127.0.0.1
